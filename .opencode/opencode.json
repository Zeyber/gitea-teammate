{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "my-provider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "my-provider",
      "options": {
        "baseURL": "https://llm.example.com/v1"
      },
      "models": {
        "my-model": {
          "name": "my-model"
        }
      }
    }
  },
  "model": "my-provider/my-model",
  "permission": {
    "external_directory": { "/tmp/*": "allow" }
  }
}
